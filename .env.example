# Salin ke .env di server dan ganti setiap [ISI]. Jangan commit .env.
# Server produksi menolak start kalau DJANGO_SECRET_KEY atau kata sandi DB kosong.

DJANGO_SECRET_KEY=[ISI]

# Database aplikasi (service web)
DB_NAME=[ISI]
DB_USER=[ISI]
# Kata sandi database harus sama dengan yang sudah dipakai volume Postgres
# (ags_pgdata). Mengubahnya di sini tidak mengubah kata sandi di dalam volume.
DB_PASSWORD=[ISI]

# Database (service db). Isi sama dengan DB_NAME, DB_USER, DB_PASSWORD.
POSTGRES_DB=[ISI]
POSTGRES_USER=[ISI]
POSTGRES_PASSWORD=[ISI]

# Login Google
GOOGLE_CLIENT_ID=[ISI]
GOOGLE_CLIENT_SECRET=[ISI]

# Daftar email guru, dipisah koma
GURU_EMAILS=[ISI]

# Alamat publik subdomain CPNS, contoh bentuknya https://cpns.contoh.com/
CPNS_URL=[ISI]

# Detik HSTS (bawaan 3600). Naikkan setelah HTTPS terbukti stabil.
SECURE_HSTS_SECONDS=[ISI]
