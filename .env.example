# Salin ke .env di server dan ganti setiap [ISI]. Jangan commit .env.
# Server produksi menolak start kalau ada nilai yang masih berisi [ISI],
# atau kalau DJANGO_SECRET_KEY atau kata sandi DB kosong.

# ===== WAJIB =====

# Kunci acak, minimal 50 karakter. Buat dengan:
# python -c "import secrets; print(secrets.token_urlsafe(64))"
DJANGO_SECRET_KEY=[ISI]

# Database aplikasi (service web)
DB_NAME=[ISI]
DB_USER=[ISI]
# Kata sandi database harus sama dengan yang sudah dipakai volume Postgres
# (ags_pgdata). Mengubahnya di sini tidak mengubah kata sandi di dalam volume.
DB_PASSWORD=[ISI]

# Database (service db). Isi sama dengan DB_NAME, DB_USER, DB_PASSWORD.
POSTGRES_DB=[ISI]
POSTGRES_USER=[ISI]
POSTGRES_PASSWORD=[ISI]

# ===== OPSIONAL =====
# Biarkan sebagai komentar supaya nilai bawaan yang aman dipakai.
# Hapus tanda # hanya kalau perlu nilai lain.

# Bawaan: agunggumelarsaputra.com, www.agunggumelarsaputra.com, cpns.agunggumelarsaputra.com
# ALLOWED_HOSTS=agunggumelarsaputra.com,www.agunggumelarsaputra.com,cpns.agunggumelarsaputra.com

# Bawaan: https:// untuk tiga domain di atas
# CSRF_TRUSTED_ORIGINS=https://agunggumelarsaputra.com,https://www.agunggumelarsaputra.com,https://cpns.agunggumelarsaputra.com

# Detik HSTS, bilangan bulat. Bawaan 3600. Naikkan setelah HTTPS terbukti stabil.
# SECURE_HSTS_SECONDS=3600

# Alamat publik subdomain CPNS. Bawaan:
# CPNS_URL=https://cpns.agunggumelarsaputra.com/

# Email guru, dipisah koma. Bawaan: dua email guru SMKN 1 Rongga.
# GURU_EMAILS=guru1@contoh.sch.id,guru2@contoh.sch.id

# Login Google. Tanpa ini tombol Masuk dengan Google tidak jalan.
# GOOGLE_CLIENT_ID=nomor-client.apps.googleusercontent.com
# GOOGLE_CLIENT_SECRET=
